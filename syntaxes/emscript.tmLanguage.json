{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EMScript",
  "scopeName": "source.emscript",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-classes"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.emscript",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.emscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.emscript",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.emscript",
      "match": "\\b-?\\d+(\\.\\d+)?\\b"
    },
    "constants": {
      "name": "constant.language.emscript",
      "match": "\\b(true|false|null)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.emscript",
          "match": "\\b(if|else|for|while|do|return|break|continue)\\b"
        },
        {
          "name": "storage.type.emscript",
          "match": "\\b(var|fun|class|static|init)\\b"
        },
        {
          "name": "keyword.other.emscript",
          "match": "\\b(new|this)\\b"
        }
      ]
    },
    "builtin-classes": {
      "comment": "BEGIN-GEN-CLASSES — regenerated by scripts/extract-api.js --write-grammar",
      "name": "support.class.emscript",
      "match": "\\b(Array|Map|Point|SwipePoint|MultiSwipe|MultiSwipeBuilder|Touch|Region|Match|MatchText|Template|TemplateBuilder|CParam|SParam|FParam|TParam|RParam|Setting|SettingBuilder|Dialog|TextView|EditText|Checkbox|RadioGroup|ImagePicker|Recorder|TabLayout|Record|OnScreenText|Con|Str|Num|Color|DateTime|TimeSpan|Stopwatch|Clipboard|Overlay|File|Sys|Cache|ScreenCapture|Env|Math|Version)\\b"
    },
    "builtin-functions": {
      "comment": "BEGIN-GEN-FUNCTIONS — regenerated by scripts/extract-api.js --write-grammar",
      "name": "support.function.emscript",
      "match": "\\b(click|swipe|wait)(?=\\s*\\()"
    },
    "function-call": {
      "name": "entity.name.function.emscript",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.emscript",
      "match": "(==|!=|<=|>=|&&|\\|\\||[+\\-*/=<>!?:])"
    }
  }
}